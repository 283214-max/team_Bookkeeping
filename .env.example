# Supabase Postgres
# Use the pooled connection string for Vercel serverless runtime.
DATABASE_URL="postgres://postgres.your-project-ref:your-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
# Vercel's Supabase/Postgres integration may provide POSTGRES_URL instead.
# The app checks DATABASE_URL first, then POSTGRES_URL.
# POSTGRES_URL="postgres://..."

# Supabase Storage
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="receipts"
